{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "checkJs": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM"],
    "paths": {
      "markdown-it-task-lists": ["./packages/fovea-markdown/src/markdown-it-task-lists.d.ts"]
    }
  },
  "include": ["packages/*/src", "examples/*/src"],
  "exclude": ["**/node_modules", "**/dist", "**/coverage"]
}
